# Puerto del servidor backend
PORT=3001

# Ruta de la base de datos SQLite (relativa al backend)
DB_PATH=./data/caruso.db

# Google Sheets - Service Account
# 1. Ir a https://console.cloud.google.com/
# 2. Crear un proyecto y habilitar Google Sheets API
# 3. Crear una Service Account y descargar el JSON de credenciales
# 4. Compartir tu hoja de Google Sheets con el email de la service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-service-account@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ID de la hoja de Google Sheets (lo encontrás en la URL: .../spreadsheets/d/ESTE_ID/edit)
GOOGLE_SPREADSHEET_ID=tu_spreadsheet_id_aqui

# Nombre de la pestaña donde se guardarán los ingresos
GOOGLE_SHEET_NAME=Ingresos

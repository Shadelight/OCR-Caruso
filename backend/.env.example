# ─── Servidor ────────────────────────────────────────────────────────────────
# Puerto del backend. En Render se asigna automáticamente (no hace falta setearlo).
PORT=3001

# Orígenes permitidos para CORS, separados por coma (sin barra final).
# En producción: la URL de tu frontend en Vercel.
# Vacío en desarrollo → permite cualquier origen.
# Ej: https://ocr-caruso.vercel.app
FRONTEND_ORIGIN=

# ─── Base de datos ───────────────────────────────────────────────────────────
# DESARROLLO: dejá Turso vacío y se usa un archivo SQLite local (DB_PATH).
DB_PATH=./data/caruso.db

# PRODUCCIÓN: credenciales de Turso (https://turso.tech).
#   turso db show <nombre> --url      → TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create <nombre>   → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Almacenamiento de imágenes ──────────────────────────────────────────────
# DESARROLLO: dejá Supabase vacío y las imágenes se guardan en ./uploads.
# PRODUCCIÓN: credenciales de Supabase Storage (https://supabase.com).
#   Project Settings → API → Project URL y service_role key.
#   Creá un bucket PÚBLICO con el nombre de SUPABASE_BUCKET.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=ocr-imagenes

# ─── Google Sheets (opcional) ────────────────────────────────────────────────
# 1. Ir a https://console.cloud.google.com/
# 2. Crear un proyecto y habilitar Google Sheets API
# 3. Crear una Service Account y descargar el JSON de credenciales
# 4. Compartir tu hoja de Google Sheets con el email de la service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-service-account@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ID de la hoja de Google Sheets (lo encontrás en la URL: .../spreadsheets/d/ESTE_ID/edit)
GOOGLE_SPREADSHEET_ID=tu_spreadsheet_id_aqui

# Nombre de la pestaña donde se guardarán los ingresos
GOOGLE_SHEET_NAME=Ingresos
